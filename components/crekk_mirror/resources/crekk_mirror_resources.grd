<?xml version="1.0" encoding="UTF-8"?>
<grit base_dir="../" latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/crekk_mirror_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="crekk_mirror_static.pak" type="data_package" />
    <output filename="grit/crekk_mirror_resources_map.cc" type="resource_file_map_source" />
    <output filename="grit/crekk_mirror_resources_map.h" type="resource_map_header" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_CREKK_MIRROR_MANIFEST" file="crekk_mirror/manifest.json" type="BINDATA" />
      <include name="IDR_CREKK_MIRROR_BACKGROUND_JS"
               resource_path="crekk_mirror/background.js"
               file="crekk_mirror/background.js"
               type="BINDATA" />
      <include name="IDR_CREKK_MIRROR_HOOKS_JS"
               resource_path="crekk_mirror/hooks.js"
               file="crekk_mirror/hooks.js"
               type="BINDATA" />
    </includes>
  </release>
</grit>
