import("//brave/build/config.gni")
import("//build/buildflag_header.gni")

declare_args() {
  enable_brave_speech_to_text = true
  service_key_stt = ""
}

if (is_official_build && enable_brave_speech_to_text) {
  assert(service_key_stt != "")
}

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "ENABLE_BRAVE_SPEECH_TO_TEXT=$enable_brave_speech_to_text",
    "SERVICE_KEY_STT=\"$service_key_stt\"",
  ]
}

component("speech_to_text") {
  output_name = "speech_to_text"
  defines = [ "IS_SPEECH_TO_TEXT_IMPL" ]

  sources = [
    "features.cc",
    "features.h",
  ]

  public_deps = [
    ":buildflags",
    "//base",
  ]
}
